# Result-page CTA link — replace with your real URL

# Option A: Web signup / registration page
VITE_CTA_URL=https://www.eloriahub.com
VITE_CTA_MODE=signup

# Option B: App download (single landing page that routes to stores)
# VITE_CTA_URL=https://yourdomain.com/download
# VITE_CTA_MODE=download

# Option C: Direct App Store link (iOS)
# VITE_CTA_URL=https://apps.apple.com/app/idXXXXXXXXX
# VITE_CTA_MODE=download

# Option D: Direct Google Play link (Android)
# VITE_CTA_URL=https://play.google.com/store/apps/details?id=com.yourapp
# VITE_CTA_MODE=download
